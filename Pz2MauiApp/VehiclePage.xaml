<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pz2MauiApp.VehiclePage"
             Title=" ">

    <ScrollView>
        <VerticalStackLayout Margin="10" Spacing="12">

            <Label Text="Транспортные средства"
                   FontSize="34"
                   FontAttributes="Bold"
                   TextColor="Black" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="18" Margin="0,10,0,10">
                <Image Source="track.png"
                       WidthRequest="100"
                       HeightRequest="100" />
                <Label Text="Список транспортных средств"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#123C69"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Шапка таблицы -->
            <Grid ColumnDefinitions="2*,2*,2*,2*,2*,2*,2*"
                  Padding="12"
                  BackgroundColor="#B7E3F6"
                  ColumnSpacing="8">
                <Label Grid.Column="0" Text="Госномер" FontSize="18" FontAttributes="Bold" TextColor="#123C69" />
                <Label Grid.Column="1" Text="Марка" FontSize="18" FontAttributes="Bold" TextColor="#123C69" />
                <Label Grid.Column="2" Text="Модель" FontSize="18" FontAttributes="Bold" TextColor="#123C69" />
                <Label Grid.Column="3" Text="Водитель" FontSize="18" FontAttributes="Bold" TextColor="#123C69" />
                <Label Grid.Column="4" Text="Расход" FontSize="18" FontAttributes="Bold" TextColor="#123C69" />
                <Label Grid.Column="5" Text="Аморт." FontSize="18" FontAttributes="Bold" TextColor="#123C69" />
                <Label Grid.Column="6" Text="Топливо" FontSize="18" FontAttributes="Bold" TextColor="#123C69" />
            </Grid>

            <!-- Таблица -->
            <CollectionView x:Name="cvVehicles"
                ItemsSource="{Binding Vehicles}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}"
                HeightRequest="260">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#8ECFE8"
                    StrokeThickness="1"
                    BackgroundColor="#EAF7FD"
                    Padding="12"
                    Margin="0,0,0,3">
                            <Grid ColumnDefinitions="2*,2*,2*,2*,2*,2*,2*" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding Number}" FontSize="16" />
                                <Label Grid.Column="1" Text="{Binding Brand}" FontSize="16" />
                                <Label Grid.Column="2" Text="{Binding Model}" FontSize="16" />
                                <Label Grid.Column="3" Text="{Binding DriverName}" FontSize="16" />
                                <Label Grid.Column="4" Text="{Binding FuelConsumption}" FontSize="16" />
                                <Label Grid.Column="5" Text="{Binding AmortizationPerKm}" FontSize="16" />
                                <Label Grid.Column="6" Text="{Binding FuelType.Name}" FontSize="16" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Госномер"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
            <Entry Text="{Binding Number}" Placeholder="Введите госномер" />

            <Label Text="Марка"
                   FontSize="18"
                   FontAttributes="Bold" />
            <Entry Text="{Binding Brand}" Placeholder="Введите марку" />

            <Label Text="Модель"
                   FontSize="18"
                   FontAttributes="Bold" />
            <Entry Text="{Binding Model}" Placeholder="Введите модель" />

            <Label Text="ФИО водителя"
                   FontSize="18"
                   FontAttributes="Bold" />
            <Entry Text="{Binding DriverName}" Placeholder="Введите ФИО водителя" />

            <Label Text="Расход топлива на 100 км"
                   FontSize="18"
                   FontAttributes="Bold" />
            <Entry Text="{Binding FuelConsumption}" Keyboard="Numeric" Placeholder="Введите расход" />

            <Label Text="Амортизация на 1 км"
                   FontSize="18"
                   FontAttributes="Bold" />
            <Entry Text="{Binding AmortizationPerKm}" Keyboard="Numeric" Placeholder="Введите амортизацию" />

            <Label Text="Вид топлива"
                   FontSize="18"
                   FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Fuels}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedFuel}"
                    Title="Выберите топливо" />

            <HorizontalStackLayout Spacing="20"
                                   HorizontalOptions="Center"
                                   Margin="0,10,0,0">

                <ImageButton Source="add_256x256.png"
                             Command="{Binding AddCommand}"
                             WidthRequest="40"
                             HeightRequest="40"
                             CornerRadius="20"
                             Pressed="IconButton_Pressed"
                             Released="IconButton_Released">
                    <ImageButton.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="IconButton_PointerEntered"
                                                  PointerExited="IconButton_PointerExited" />
                    </ImageButton.GestureRecognizers>
                </ImageButton>

                <ImageButton Source="refresh_256x256.png"
                             Command="{Binding UpdateCommand}"
                             WidthRequest="40"
                             HeightRequest="40"
                             CornerRadius="20"
                             Pressed="IconButton_Pressed"
                             Released="IconButton_Released">
                    <ImageButton.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="IconButton_PointerEntered"
                                                  PointerExited="IconButton_PointerExited" />
                    </ImageButton.GestureRecognizers>
                </ImageButton>

                <ImageButton Source="remove_256x256.png"
                             Command="{Binding RemoveCommand}"
                             CommandParameter="{Binding Source={x:Reference cvVehicles}, Path=SelectedItem}"
                             WidthRequest="40"
                             HeightRequest="40"
                             CornerRadius="20"
                             Pressed="IconButton_Pressed"
                             Released="IconButton_Released">
                    <ImageButton.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="IconButton_PointerEntered"
                                                  PointerExited="IconButton_PointerExited" />
                    </ImageButton.GestureRecognizers>
                </ImageButton>

            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>