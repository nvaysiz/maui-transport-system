<Shell
    x:Class="Pz2MauiApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Pz2MauiApp">

    <ShellContent
    Title="Главаная"
    ContentTemplate="{DataTemplate local:MainPage}" 
        Route="MainPage"/>


    <ShellContent
        Title="Топливо"
        ContentTemplate="{DataTemplate local:FuelPage}" 
        Route="FuelPage"/>

    <ShellContent
        Title="Транспорт"
        ContentTemplate="{DataTemplate local:VehiclePage}"
         Route="VehiclePage" />

    <ShellContent
        Title="Рейсы"
        ContentTemplate="{DataTemplate local:TripPage}"
        Route="TripPage"/>

</Shell>