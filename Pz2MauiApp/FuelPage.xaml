<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pz2MauiApp.FuelPage"
             Title=" ">

    <ScrollView>
        <VerticalStackLayout Margin="10" Spacing="12">

            <!-- Большой заголовок слева -->
            <Label Text="Топливо"
                   FontSize="34"
                   FontAttributes="Bold"
                   TextColor="Black" />

            <!-- Иконка и заголовок по центру -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="18" Margin="0,10,0,10">
                <Image Source="fuel.png"
                       WidthRequest="100"
                       HeightRequest="100" />
                <Label Text="Список видов топлива"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#123C69"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Шапка таблицы -->
            <Grid ColumnDefinitions="3*,2*"
                  Padding="12"
                  BackgroundColor="#B7E3F6">
                <Label Grid.Column="0"
                       Text="Название"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#123C69" />
                <Label Grid.Column="1"
                       Text="Цена (руб./л)"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#123C69"
                       HorizontalTextAlignment="End" />
            </Grid>

            <!-- Таблица -->
            <CollectionView x:Name="cvFuels"
                ItemsSource="{Binding Fuels}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedFuel, Mode=TwoWay}"
                HeightRequest="190">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#8ECFE8"
                    StrokeThickness="1"
                    BackgroundColor="#EAF7FD"
                    Padding="12"
                    Margin="0,0,0,3">
                            <Grid ColumnDefinitions="3*,2*">
                                <Label Grid.Column="0"
                           Text="{Binding Name}"
                           FontSize="16"
                           VerticalOptions="Center" />
                                <Label Grid.Column="1"
                           Text="{Binding PricePerLiter, StringFormat='{}{0}'}"
                           FontSize="16"
                           HorizontalTextAlignment="End"
                           VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Наименование топлива"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="Black"
                   Margin="0,10,0,0" />

            <Entry Text="{Binding Name}"
                   Placeholder="Введите название топлива" />

            <Label Text="Цена за литр"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="Black" />

            <Entry Text="{Binding PricePerLiter}"
                   Placeholder="Введите цену"
                   Keyboard="Numeric" />

            <HorizontalStackLayout Spacing="20"
                                   HorizontalOptions="Center"
                                   Margin="0,10,0,0">

                <ImageButton Source="add_256x256.png"
                             Command="{Binding AddCommand}"
                             WidthRequest="40"
                             HeightRequest="40"
                             CornerRadius="20"
                             Pressed="IconButton_Pressed"
                             Released="IconButton_Released">
                    <ImageButton.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="IconButton_PointerEntered"
                                                  PointerExited="IconButton_PointerExited" />
                    </ImageButton.GestureRecognizers>
                </ImageButton>

                <ImageButton Source="refresh_256x256.png"
                             Command="{Binding UpdateCommand}"
                             WidthRequest="40"
                             HeightRequest="40"
                             CornerRadius="20"
                             Pressed="IconButton_Pressed"
                             Released="IconButton_Released">
                    <ImageButton.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="IconButton_PointerEntered"
                                                  PointerExited="IconButton_PointerExited" />
                    </ImageButton.GestureRecognizers>
                </ImageButton>

                <ImageButton Source="remove_256x256.png"
                             Command="{Binding RemoveCommand}"
                             CommandParameter="{Binding Source={x:Reference cvFuels}, Path=SelectedItem}"
                             WidthRequest="40"
                             HeightRequest="40"
                             CornerRadius="20"
                             Pressed="IconButton_Pressed"
                             Released="IconButton_Released">
                    <ImageButton.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="IconButton_PointerEntered"
                                                  PointerExited="IconButton_PointerExited" />
                    </ImageButton.GestureRecognizers>
                </ImageButton>

            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>